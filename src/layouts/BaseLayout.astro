---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  schema?: object | object[];
}

const { title, description, path = '/', schema } = Astro.props;
const siteUrl = 'https://properfacilities.com';
const canonical = new URL(path, siteUrl).toString();
const ogImage = new URL('/og-image.png', siteUrl).toString();

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Proper Facilities Management',
  url: siteUrl,
  description: 'National facilities management for restaurant and retail brands — HVAC, electrical, plumbing, handyman, signage, and 24/7 emergency response across every location.',
  areaServed: 'US',
  sameAs: [],
};

const schemaList = Array.isArray(schema) ? schema : schema ? [schema] : [];
const allSchema = [orgSchema, ...schemaList];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Proper Facilities Management</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${title} | Proper Facilities Management`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | Proper Facilities Management`} />
  <meta name="twitter:description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  {allSchema.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
