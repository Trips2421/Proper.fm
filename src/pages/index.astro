---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  { title: 'Daily Janitorial & Porter Services', desc: 'Nightly and daily cleaning routes plus on-site day porters, so restrooms and common areas stay guest-ready.', href: '/services#janitorial' },
  { title: 'Floor Care', desc: 'Carpet, concrete, stone, tile, and wood floor cleaning, restoration, repair, and installation.', href: '/services#floor-care' },
  { title: 'Window & Glass Cleaning', desc: 'Storefront and interior glass kept spotless, on a recurring route or as a one-time job.', href: '/services#window-glass' },
  { title: 'Pressure Washing & Softwashing', desc: 'Sidewalks, drive-thrus, dumpster pads, and exteriors washed to look like opening day.', href: '/services#exterior' },
  { title: 'Construction & Turnover Cleanup', desc: 'Post-construction and remodel cleanup that gets a location from job site to open.', href: '/services#construction-cleanup' },
  { title: 'Facilities Repairs & Maintenance', desc: 'General maintenance, plumbing, pest control, HVAC, electrical, and signage — added on when you need one partner for everything.', href: '/services#facilities-services' },
];

const steps = [
  { n: '01', title: 'One call or ticket', desc: 'Your team reports a cleaning need or maintenance issue once — to us, not to a directory of local vendors.' },
  { n: '02', title: 'Vetted crew dispatched', desc: 'We route it to a qualified cleaning crew or technician in our network, matched to the service and the location.' },
  { n: '03', title: 'Tracked to close', desc: 'Your account manager follows the job through completion and keeps a record for every site.' },
];

const partners = [
  { name: 'ServiceChannel', img: '/partners/servicechannel.svg' },
  { name: 'MaintainX', img: '/partners/maintainx.svg' },
  { name: 'Fixxbook', img: null },
  { name: 'RFMA', img: null },
  { name: 'ConnexFM', img: '/partners/connexfm.png' },
  { name: 'Facil-IT', img: '/partners/facilit.png' },
];
---
<BaseLayout
  title="National Commercial Cleaning & Facilities Management for Restaurants & Retail"
  description="Proper Facilities Management is a national commercial cleaning and facilities partner for restaurant and retail brands — daily janitorial, floor care, window cleaning, and pressure washing, plus HVAC, electrical, and plumbing, across every location, through one point of contact."
  path="/"
>
  <section class="on-dark">
    <div class="wrap">
      <span class="eyebrow">National Cleaning & Facilities Partner</span>
      <h1 style="font-size:56px; max-width:760px;">Every location. Properly cleaned.</h1>
      <p class="lede" style="font-size:19px; max-width:580px; margin-top:20px;">
        One partner for commercial cleaning and janitorial — daily porter service, floor care, window cleaning, and
        pressure washing — across every restaurant or retail location you operate. Dispatched through a vetted
        network and tracked by a dedicated account manager. HVAC, electrical, and plumbing support included when you need it.
      </p>
      <div style="display:flex; gap:16px; flex-wrap:wrap; margin-top:32px;">
        <a href="/contact" class="btn btn-primary">Request a proposal</a>
        <a href="/services" class="btn btn-secondary">See our services</a>
      </div>
    </div>
  </section>

  <section class="on-white tight">
    <div class="wrap" style="text-align:center;">
      <span class="eyebrow">Trusted By</span>
      <p class="lede" style="max-width:720px; margin:0 auto;">Proper partners with national restaurant and retail brands — from fast-casual and quick-service dining to specialty apparel retail — who need one partner they can trust across every location.</p>
    </div>
  </section>

  <section class="on-cream">
    <div class="wrap">
      <span class="eyebrow">How It Works</span>
      <h2 class="section-title">One call. Every location, running right.</h2>
      <p class="lede">No juggling a directory of local cleaning crews and vendors per city. Proper is the single point of contact for cleaning and facilities care, at every site.</p>
      <div class="grid-3">
        {steps.map((s) => (
          <div class="card">
            <div style="font-family:'Space Grotesk',sans-serif; font-weight:700; color:var(--moss); font-size:14px; margin-bottom:10px;">{s.n}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="on-white">
    <div class="wrap">
      <span class="eyebrow">Services</span>
      <h2 class="section-title">Commercial cleaning first — facilities care when you need it</h2>
      <p class="lede">From nightly janitorial to the 2am repair call nobody wants to make — one partner covers it.</p>
      <div class="grid-3">
        {services.map((svc) => (
          <a href={svc.href} class="card" style="text-decoration:none; display:block;">
            <div class="icn">
              <svg viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4 10-10" stroke="#F3F1EC" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3>{svc.title}</h3>
            <p>{svc.desc}</p>
          </a>
        ))}
      </div>
      <div style="margin-top:32px;">
        <a href="/services" class="btn btn-secondary">See the full service list</a>
      </div>
    </div>
  </section>

  <section class="on-dark">
    <div class="wrap grid-2">
      <div>
        <span class="eyebrow">Why Proper</span>
        <h2 class="section-title">Built for multi-location operators</h2>
        <p class="lede">Facilities directors don't need another vendor — they need fewer of them.</p>
      </div>
      <ul class="checklist">
        <li><span class="check"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4 10-10" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>A single point of contact across every location, in every city</li>
        <li><span class="check"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4 10-10" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>A vetted network of cleaning crews, day porters, and technicians</li>
        <li><span class="check"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4 10-10" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>A dedicated account manager who knows your locations and standards</li>
        <li><span class="check"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4 10-10" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Recurring cleaning and preventive maintenance programs built around your brand's standards</li>
      </ul>
    </div>
  </section>

  <section class="on-cream">
    <div class="wrap">
      <span class="eyebrow">Industries</span>
      <h2 class="section-title">Built around how your business runs</h2>
      <div class="grid-2" style="margin-top:24px;">
        <a href="/industries#restaurants" class="card" style="text-decoration:none; display:block;">
          <h3 style="font-size:22px; margin-bottom:10px;">Restaurants</h3>
          <p>Dining room, restroom, and back-of-house cleaning plus kitchen equipment upkeep that protects the guest experience — and the health inspection.</p>
        </a>
        <a href="/industries#retail" class="card" style="text-decoration:none; display:block;">
          <h3 style="font-size:22px; margin-bottom:10px;">Retail</h3>
          <p>Storefront glass, floor care, and facilities maintenance that keeps every location on-brand and open.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="on-white tight">
    <div class="wrap" style="text-align:center;">
      <span class="eyebrow">Technology & Network Partners</span>
      <h2 class="section-title" style="font-size:24px; margin-bottom:8px;">Backed by the platforms and networks facilities teams already use</h2>
      <div class="partners-strip">
        {partners.map((p) => (
          p.img
            ? <img src={p.img} alt={`${p.name} logo`} />
            : <span class="text-mark">{p.name}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="on-dark tight">
    <div class="wrap" style="text-align:center;">
      <h2 class="section-title">Ready for one partner across every location?</h2>
      <p class="lede" style="margin:0 auto 28px;">Tell us how many locations you operate and we'll put together a proposal.</p>
      <a href="/contact" class="btn btn-primary">Request a proposal</a>
    </div>
  </section>
</BaseLayout>
