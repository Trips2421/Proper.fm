---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:14px;">
          <span style="width:28px; height:28px; display:block;"><Logo variant="cream" /></span>
          <span style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:17px; color:#F3F1EC;">Proper</span>
        </div>
        <p style="font-size:13.5px; max-width:260px;">National facilities management for restaurant and retail brands. One partner, every location.</p>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/industries">Industries</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>Services</h4>
        <ul>
          <li><a href="/services#hvac">HVAC &amp; Refrigeration</a></li>
          <li><a href="/services#electrical">Electrical &amp; Lighting</a></li>
          <li><a href="/services#emergency">24/7 Emergency Response</a></li>
          <li><a href="/services#preventive">Preventive Maintenance</a></li>
        </ul>
      </div>
      <div>
        <h4>Get in touch</h4>
        <ul>
          <li><a href="mailto:hello@properfacilities.com">hello@properfacilities.com</a></li>
          <li><a href="/contact">Request a proposal</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {year} Proper Facilities Management. All rights reserved.</span>
      <span>Serving restaurant and retail brands nationwide.</span>
    </div>
  </div>
</footer>
