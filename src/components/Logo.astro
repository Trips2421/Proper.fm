---
interface Props {
  variant?: 'ink' | 'cream';
}
const { variant = 'ink' } = Astro.props;
const bg = variant === 'ink' ? '#17181A' : '#F3F1EC';
const check = variant === 'ink' ? '#F3F1EC' : '#17181A';
---
<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Proper Facilities Management">
  <rect width="64" height="64" rx="16" fill={bg}></rect>
  <path d="M18 33.5 L27.5 43 L47 21" stroke={check} stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
</svg>
